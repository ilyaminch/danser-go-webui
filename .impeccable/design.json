      "css": ".ds-play{font-family:Nunito,sans-serif;cursor:pointer;transition:background .15s,transform .15s;display:grid;place-items:center;width:46px;height:46px;border:1px solid #ed67a270;border-radius:50%;color:var(--pink,#ff66aa);background:#382034;}.ds-play:hover:enabled{background:#56304b;}.ds-play:focus-visible{outline:2px solid var(--cyan,#58d7df);outline-offset:4px;}.ds-play:disabled{opacity:.4;cursor:not-allowed;}"
